# Required for the private publisher/admin engine.
# Generate a long random secret and store it only in the server environment.
ADMIN_ACCESS_KEY=

# Primary premium AI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# OpenRouter fallback. OPENROUTER_MODEL defaults to openrouter/free when omitted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional attribution headers for OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Mabrig PublishAI

# Groq fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Provider priority in the app:
# OpenAI -> OpenRouter -> Groq -> Gemini -> deterministic non-AI report.
