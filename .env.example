# Required for the private publisher/admin engine.
# Generate a long random secret and store it only in the server environment.
ADMIN_ACCESS_KEY=

# Scholarly discovery / journal matching.
# Optional but recommended when you have an OpenAlex API key.
OPENALEX_API_KEY=

# Primary premium AI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# OpenRouter fallback. openrouter/free dynamically selects an available free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional attribution headers for OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Mabrig PublishAI

# Fast high-capability fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Long-context fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Provider priority in the app:
# OpenAI -> OpenRouter -> Groq -> Gemini -> deterministic non-AI report.
